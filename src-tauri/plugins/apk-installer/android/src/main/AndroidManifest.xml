<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <provider
            android:name="by.tomashevich.apkinstaller.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/unitrack_update_paths" />
        </provider>
        <!-- Иконки на выбор: включён ровно один ярлык. Сам MainActivity без LAUNCHER (см. scripts/android-icons.mjs). -->
        <activity-alias
            android:name="by.tomashevich.unitrack.IconLilac"
            android:targetActivity="by.tomashevich.unitrack.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="UniTrack"
            android:icon="@mipmap/ic_alt_lilac"
            android:roundIcon="@mipmap/ic_alt_lilac">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
